{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

set -e -u

# Install only what's missing. Upgrading already-installed packages can quit running
# apps, so that stays a deliberate `brew upgrade`.
brew bundle --no-upgrade --file=/dev/stdin <<EOF

{{ if .packages.darwin.brews -}}
{{ range .packages.darwin.brews -}}
brew {{ . | quote }}{{ if contains "/" . }}, trusted: true{{ end }}
{{ end -}}
{{ end -}}

{{ range .packages.darwin.casks.default -}}
cask {{ . | quote }}{{ if contains "/" . }}, trusted: true{{ end }}
{{ end -}}
{{ if ne .profile "work" -}}
{{ range .packages.darwin.casks.restricted -}}
cask {{ . | quote }}{{ if contains "/" . }}, trusted: true{{ end }}
{{ end -}}
{{ end -}}

EOF
{{ end -}}
