#!/bin/bash

set -e

# Only needed on Linux when starship wasn't installed by the system package manager
# (e.g. devcontainer, where apt and brew are unavailable or skipped)
[[ "{{ .chezmoi.os }}" == "linux" ]] || exit 0

mkdir -p "$HOME/.local/bin"

if ! command -v starship >/dev/null 2>&1; then
    echo "Installing starship..."
    curl -sL "https://github.com/starship/starship/releases/latest/download/starship-x86_64-unknown-linux-gnu.tar.gz" \
        | tar -xz -C "$HOME/.local/bin" starship
fi
