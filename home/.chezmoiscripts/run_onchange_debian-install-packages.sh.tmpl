{{- if and (eq .chezmoi.os "linux") (lookPath "apt-get") (ne .profile "devcontainer") -}}
#!/bin/sh

set -e -u

echo "Updating APT cache and installing packages..."
if ! sudo apt-get update; then
    echo ""
    echo "Error: 'apt-get update' failed. Possible causes:"
    echo "  - Your Ubuntu/Debian version is EOL and its repos have been removed"
    echo "  - Network connectivity issues"
    echo ""
    echo "Fix /etc/apt/sources.list or upgrade your OS, then re-run: chezmoi apply"
    exit 1
fi

{{- if .packages.debian.apts }}
{{- range .packages.debian.apts }}
if ! dpkg -l {{ . | quote }} >/dev/null 2>&1; then
    echo "Installing apt package: {{ . }}"
    sudo apt-get install -y {{ . | quote }}
fi
{{- end }}
{{- end }}

if ! command -v starship >/dev/null 2>&1; then
    echo "Installing starship..."
    # starship.rs/install.sh is blocked in proxy-restricted environments; use pinned GitHub release
    STARSHIP_VERSION="v1.22.1"
    STARSHIP_URL="https://github.com/starship/starship/releases/download/${STARSHIP_VERSION}/starship-x86_64-unknown-linux-gnu.tar.gz"
    curl -sL "$STARSHIP_URL" | tar -xz -C ~/.local/bin starship
fi

{{ end -}}
