{{- if and (eq .chezmoi.os "darwin") (eq .profile "personal") (not .disableSSHGitConfig) -}}
#!/bin/bash
#
# Builds the ntfy server binary from source and installs it at
# ~/.local/bin/ntfy-server.
#
# Why we build instead of downloading:
#   - Homebrew's `ntfy` formula is client-only (uses -tags noserver).
#   - Upstream's macOS release tarball is also client-only (goreleaser
#     ntfy_darwin_all build excludes the server).
#   - Upstream's `cmd/serve_unix.go` excludes darwin from its build
#     constraint, so we patch that line during the build.
#
# Idempotent: if the installed binary already reports the pinned version,
# the build is skipped. Bumping VERSION below changes the rendered script
# content and chezmoi re-runs this script on next apply.

set -u

VERSION="2.22.0"

dest_dir="$HOME/.local/bin"
dest_bin="$dest_dir/ntfy-server"

if [ -x "$dest_bin" ] && "$dest_bin" help 2>&1 | grep -q "^ntfy $VERSION "; then
  exit 0
fi

if ! command -v go >/dev/null 2>&1; then
  echo "notify-bridge: go is not installed (expected from packages.yaml)" >&2
  exit 1
fi
if ! command -v git >/dev/null 2>&1; then
  echo "notify-bridge: git is not installed" >&2
  exit 1
fi

mkdir -p "$dest_dir"

src=$(mktemp -d)
trap 'rm -rf "$src"' EXIT

echo "notify-bridge: building ntfy server $VERSION from source..."

if ! git clone --depth 1 -b "v$VERSION" https://github.com/binwiederhier/ntfy.git "$src/ntfy" 2>&1 | tail -3; then
  echo "notify-bridge: git clone failed" >&2
  exit 1
fi

cd "$src/ntfy" || exit 1

# Patch: ntfy's cmd/serve_unix.go excludes darwin via build constraint.
# Add darwin so the server compiles on macOS. The functions referenced
# from that file (sigHandlerConfigReload, maybeRunAsService) are portable.
python3 <<'PY' || { echo "notify-bridge: patch failed" >&2; exit 1; }
p = "cmd/serve_unix.go"
s = open(p).read()
needle = "//go:build linux || dragonfly"
if needle not in s:
    raise SystemExit(f"patch needle not found in {p} — upstream layout changed?")
patched = s.replace(needle, "//go:build linux || darwin || dragonfly", 1)
open(p, "w").write(patched)
PY

# The server.go file embeds server/docs and server/site directories.
# We don't ship the web UI or generated docs — empty placeholders satisfy
# the //go:embed directives. Mirrors `make cli-deps-static-sites`.
mkdir -p server/docs server/site
touch server/docs/index.html server/site/app.html

build_date=$(date +%s)
ldflags="-s -w -X main.version=$VERSION -X main.date=$build_date -X main.commit=src"

CGO_ENABLED=1 go build \
  -tags sqlite_omit_load_extension,osusergo,netgo \
  -ldflags "$ldflags" \
  -o "$src/ntfy-server" \
  . 2>&1 | tail -20
if [ ! -x "$src/ntfy-server" ]; then
  echo "notify-bridge: go build failed" >&2
  exit 1
fi

# Atomic install: write to a sibling and rename.
install_tmp="$dest_bin.new"
cp "$src/ntfy-server" "$install_tmp"
chmod +x "$install_tmp"
mv -f "$install_tmp" "$dest_bin"

echo "notify-bridge: installed $dest_bin ($VERSION)"
{{- end }}
