# https://ghostty.org/docs/config/reference
# After making changes, reload the config by pressing CMD+SHIFT+,

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

mouse-hide-while-typing = true

working-directory = home
window-inherit-working-directory = false
tab-inherit-working-directory = false
split-inherit-working-directory = true

window-new-tab-position = end

notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
notify-on-command-finish-after = 10s

# Also, allow Notifications in the System Settings:
# System Settings → Notifications → Ghostty → Turn on "Allow Notifications" 
desktop-notifications = true

auto-update = download
auto-update-channel = stable

# Option key sends alt codes properly, which allows unbinding of keys that rely
# on the option key signals
macos-option-as-alt = true

# Unbind left and right navigation so that Ghostty sends normal terminal
# signals for these ops, allowing Herdr to interpret them too. Otherwise,
# alt+(left|right) does not work in Herdr
keybind = alt+left=unbind
keybind = alt+right=unbind

# Temporarily fix the pasting to searchbar failures. The fix comes from this
# thread: https://github.com/ghostty-org/ghostty/discussions/11530#discussioncomment-16657838
# Once https://github.com/ghostty-org/ghostty/issues/10749 closes this can be
# removed
keybind = super+v=paste_from_clipboard
