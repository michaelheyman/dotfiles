{{- if and (eq .chezmoi.os "darwin") (eq .profile "personal") (not .disableSSHGitConfig) }}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.user.claude-notify-subscriber</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{ if eq .chezmoi.arch "arm64" }}/opt/homebrew{{ else }}/usr/local{{ end }}/bin/ntfy</string>
    <string>subscribe</string>
    <string>--config</string>
    <string>{{ .chezmoi.homeDir }}/.claude/notify-bridge/subscriber/client.yml</string>
    <string>--from-config</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>{{ .chezmoi.homeDir }}/.claude/notify-bridge/logs/subscriber.log</string>

  <key>StandardErrorPath</key>
  <string>{{ .chezmoi.homeDir }}/.claude/notify-bridge/logs/subscriber.err</string>
</dict>
</plist>
{{- end }}
