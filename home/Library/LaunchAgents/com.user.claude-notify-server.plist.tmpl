{{- if and (eq .chezmoi.os "darwin") (eq .profile "personal") (not .disableSSHGitConfig) }}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.user.claude-notify-server</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{ .chezmoi.homeDir }}/.local/bin/ntfy-server</string>
    <string>serve</string>
    <string>--listen-http</string>
    <string>{{ if (index . "notifyBridgeAllowDevcontainer" | default false) }}0.0.0.0{{ else }}127.0.0.1{{ end }}:2586</string>
    <string>--cache-file</string>
    <string>{{ .chezmoi.homeDir }}/.claude/notify-bridge/logs/ntfy-cache.db</string>
    <string>--auth-default-access</string>
    <string>read-write</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>{{ .chezmoi.homeDir }}/.claude/notify-bridge/logs/server.log</string>

  <key>StandardErrorPath</key>
  <string>{{ .chezmoi.homeDir }}/.claude/notify-bridge/logs/server.err</string>
</dict>
</plist>
{{- end }}
