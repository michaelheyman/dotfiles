"------------------------------------------------------------------------------
" CORE / INITIALIZATION
"------------------------------------------------------------------------------

" Run VIM without backward compatibility with vi in order to leverage
" more modern features and sensible defaults.
" https://vimdoc.sourceforge.net/htmldoc/options.html#'compatible'
set nocompatible

source ~/.vim/plugins.vim

" vim-plug will have set `filetype plugin indent on` and `syntax enable`, which
" is why they are not included here

" Allows buffer switching to another buffer without having to save it first
set hidden

"==============================================================================
" GLOBAL USABILITY & BEHAVIOR
"==============================================================================

" Use case insensitive search, except when using capital letters
set ignorecase
set smartcase

" Highlight searches without requiring :noh afterwards
" https://vimdoc.sourceforge.net/htmldoc/options.html#'incsearch'
set incsearch nohlsearch

" --- Backup & Undo ---
" Disable swap and backup files
set noswapfile
set nobackup
" Enable persistent undo so undo history is saved across sessions
set undofile
set undodir=~/.vim/undo

" --- Window & Buffer Movement ---
" Open vertical splits to the right
set splitright
" Open terminal/horizontal splits on the bottom instead of above
set splitbelow
" Prevent {} motion from opening fold
set foldopen-=block
" Remove delay from inserting new line with O
set ttimeoutlen=100

" Remember last cursor position
if has("autocmd")
  au BufReadPost * if line("'\"") > 1 && line("'\"") <= line("$") | exe "normal! g'\"" | endif
endif

"==============================================================================
" INDENTATION & FORMATTING
"==============================================================================

" Use spaces instead of tabs
set expandtab

" Indent options
set softtabstop=4
set shiftwidth=4

" Set maximum text width to 79 characters before wrapping
set tw=79

" Set a color on the 80th column of a line to subtly indicate length limit
highlight OverLength ctermbg=red ctermfg=white
match OverLength /\%80v\+/

"==============================================================================
" APPEARANCE & AESTHETICS
"==============================================================================

" --- Colorscheme ---
set background=dark
" Run with silent to suppress error if w0ng/vim-hybrid colorscheme not found
silent! colorscheme hybrid
set cursorline
set number

" Configure builtin file explorer netrw
let g:netrw_liststyle = 3 " set default netrw view to tree
let g:netrw_banner = 0
let g:netrw_winsize = 25

"==============================================================================
" PLUGIN CONFIGURATION
"==============================================================================

" haskell-vim options
let g:haskell_enable_quantification = 1   " to enable highlighting of `forall`
let g:haskell_enable_recursivedo = 1      " to enable highlighting of `mdo` and `rec`
let g:haskell_enable_arrowsyntax = 1      " to enable highlighting of `proc`
let g:haskell_enable_pattern_synonyms = 1 " to enable highlighting of `pattern`
let g:haskell_enable_typeroles = 1        " to enable highlighting of type roles
let g:haskell_enable_static_pointers = 1  " to enable highlighting of `static`
let g:haskell_backpack = 1                " to enable highlighting of backpack keywords

" vim-airline
"Automatically displays all buffers when there's only one tab open.
let g:airline#extensions#tabline#enabled = 1
let g:airline_theme="distinguished"

"==============================================================================
" KEY REMAPS & CUSTOM FUNCTIONS
"==============================================================================

" Allow for capitalized commands when exiting and saving
command W w
command Wq wq
command Q q

" Clear highlighted search
nmap <leader>q :nohlsearch<CR>

" Move between open buffers
nmap gn :bn<CR>
nmap gp :bp<CR>

" Bind CTRL+N to toggle number modes (absolute/relative/none)
function! NumberToggle()
  if(&relativenumber == 1)
    set norelativenumber
  elseif(&number == 1)
    set nonumber
    set relativenumber
  else
    set number
  endif
endfunc
nnoremap <silent> <C-n> :call NumberToggle()<cr>
