#!/bin/bash

# Run docker-compose ps on docker-compose files

if [ $# -gt 1 ]
then
    echo "Usage: $0 <environment>"
    exit 1
fi

if [ $1 ]
then
    echo "docker-compose -f docker-compose-$1.yml ps"
    docker-compose -f docker-compose-$1.yml ps
else
    echo "docker-compose -f docker-compose.yml ps"
    docker-compose -f docker-compose.yml ps
fi
