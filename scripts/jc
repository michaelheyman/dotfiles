#!/bin/bash

# This script assumes you have jenv and openjdk-11.0.2 installed. They are
# typically found in /Library/Java/JavaVirtualMachines/<version>/Contents/Home

info () {
    printf "\r\033[2K[ \033[00;32mi\033[0m ] $1\n"
}

# Java project
if [[ -f pom.xml ]]
then
    # This maven plugin ensures that mvn picks up the right java version based
    # off your jenv settings and .java-version file
    eval "$(jenv init -)"
    jenv enable-plugin maven

    info 'Running mvn clean package to clear artifacts...'
    info "Java project detected: running 'mvn clean package' to clear artifacts followed by 'janus cuke"
    mvn clean package
    janus cuke
# Go project
elif [[ -f go.mod ]]
then
    info "Go project detected: running 'make cuke'"
    make cuke
# Everything else
else
    janus cuke
fi

